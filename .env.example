# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Gemini API Key for AI enrichments
VITE_GEMINI_API_KEY=your-gemini-api-key

# ==============================================================================
# Server-Side Configuration (Supabase Edge Functions Secrets)
# Set via: npx supabase secrets set LINKEDIN_CLIENT_ID=...
# NEVER prefix with VITE_ or expose these secrets to browser bundles!
# ==============================================================================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# For local dev: http://127.0.0.1:54321/functions/v1/linkedin-oauth-callback
# For production: https://<project-ref>.supabase.co/functions/v1/linkedin-oauth-callback
LINKEDIN_REDIRECT_URI=replace-with-confirmed-oauth-callback
LINKEDIN_TOKEN_ENCRYPTION_KEY=replace-with-generated-32-byte-hex-key
APP_BASE_URL=http://localhost:5173

# Server-Side Groq API Secret for AI candidate web search
# Set via: npx supabase secrets set GROQ_API_KEY=your-groq-api-key
GROQ_API_KEY=your-groq-api-key